# SHARED GitHub Actions VARIABLES — the house rules every repo calling the
# shared workflows gets. Non-sensitive; committed; published with the package.
#
# A repo adds or overrides any key in its own .github/actions.env; the repo's
# value wins. Keep here only what is genuinely the same everywhere — anything
# tied to one project (AUTO_PROJECT_NUMBER, AUTO_MILESTONE_TITLE, deploy
# settings) belongs to that repo.
#
# Read at run time, never copied onto repos: the actions load this file from the
# copy of ebalzan/ci the runner downloads for `uses: …@v2`
# (actions/auto-work-items/src/sharedVars.ts) and fill every key the repo leaves
# unset. A change here reaches the repos when it is released and the major tag
# moves to it — no bootstrap run.
#
# Only values that differ from the code defaults live here
# (actions/auto-work-items/src/config.ts, describe.ts, project.ts): priority
# comes from TYPE_CONFIG, size defaults to M, estimate to 1, dates to
# today → +7 days, strict metadata on, the board owner is the repo owner, and
# no board or milestone unless the repo sets one. The workflows pass the repo's
# variables whole (REPO_VARS_JSON), so setting a key here or in a repo is all it
# takes — no workflow edit.
#
# Full key reference: docs/CONFIGURATION.md.

# Claude model that writes the issue/PR descriptions (describe.ts). Kept here,
# not just as the code default, so it can be switched without a code change.
# AUTO_DESCRIBE_EFFORT: low | medium | high | xhigh | max — ignored for Haiku,
# which does not accept it.
AUTO_DESCRIBE_MODEL=claude-sonnet-5-5
AUTO_DESCRIBE_EFFORT=low

AUTO_SIZE_MAP_JSON={"feat":"M","fix":"S","docs":"S","style":"S","refact":"M","perf":"M","test":"S","build":"S","ci":"S","chore":"S","revert":"S"}
AUTO_ESTIMATE_MAP_JSON={"feat":"3","fix":"2","docs":"1","style":"1","refact":"2","perf":"2","test":"1","build":"1","ci":"1","chore":"1","revert":"1"}
