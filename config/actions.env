# SHARED GitHub Actions VARIABLES — every repo in repos.env gets these.
# Non-sensitive; committed. Synced with `bin/gh-bootstrap.sh --all`.
#
# A repo adds or overrides any key in its own .github/actions.env; the repo's
# value wins. Keep here only what is genuinely the same everywhere — a value
# that differs per repo (AUTO_PROJECT_NUMBER, VERCEL_*) belongs to that repo.
#
# Personal accounts have no org-level Actions config, so "shared" is a sync-time
# idea: the bootstrap writes the merged result onto each repository. Changing a
# value here does nothing until you re-run it.
#
# Only values that differ from the code defaults live here
# (actions/auto-work-items/src/config.ts, describe.ts, project.ts): priority
# comes from TYPE_CONFIG, size defaults to M, estimate to 1, dates to
# today → +7 days, strict metadata on. Every AUTO_* knob the script reads is
# wired in .github/workflows/auto-work-items.yml, so setting one here or in a
# repo is all it takes — no workflow edit.

# Account that owns the Projects (v2) boards. Each repo sets its own
# AUTO_PROJECT_NUMBER (one board per repo).
AUTO_PROJECT_OWNER=ebalzan
# Milestones are per repo on GitHub, but all three use the same title.
AUTO_MILESTONE_TITLE=oct-26

# Claude model that writes the issue/PR descriptions (describe.ts). Kept here,
# not just as the code default, so it can be switched without a code change.
# AUTO_DESCRIBE_EFFORT: low | medium | high | xhigh | max — ignored for Haiku,
# which does not accept it.
AUTO_DESCRIBE_MODEL=claude-sonnet-5-5
AUTO_DESCRIBE_EFFORT=low

AUTO_SIZE_MAP_JSON={"feat":"M","fix":"S","docs":"S","style":"S","refact":"M","perf":"M","test":"S","build":"S","ci":"S","chore":"S","revert":"S"}
AUTO_ESTIMATE_MAP_JSON={"feat":"3","fix":"2","docs":"1","style":"1","refact":"2","perf":"2","test":"1","build":"1","ci":"1","chore":"1","revert":"1"}
