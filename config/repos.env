# Repos that the --all flag of bin/gh-bootstrap.sh and
# bin/sync-managed.sh acts on: checkout directory names, relative to the
# directory holding this tracebim-ci checkout (override: TRACEBIM_REPOS_ROOT).
REPOS=tracebim-api tracebim-frontend tracebim-frontend-mobile

# Where this repo lives. It is private and shares its workflows through
# "Accessible from repositories owned by the user", so only repos owned by this
# same account can call them. The bootstrap warns about any repo that is not.
CI_REPO=ebalzan/tracebim-ci
