# Which repos `--all` acts on (bin/gh-bootstrap.sh).
# The union of both lists below is used; a repo listed twice is synced once.
#
# Discovery by topic (recommended): every repo of REPOS_OWNER tagged with
# REPOS_TOPIC. `ebalzan-ci onboard` adds the topic, so onboarding a repo needs
# no edit here. Leave REPOS_TOPIC empty to turn discovery off.
REPOS_TOPIC=ebalzan-ci
# Account whose repos are searched for the topic. Empty = the account gh is
# logged in as (`gh api user`).
REPOS_OWNER=

# Explicit extra repos, as OWNER/REPO slugs separated by spaces — e.g. repos of
# another account or organization you administer.
REPOS=

# Where `--all` looks for local checkouts: <CI_REPOS_ROOT>/<repo name>. A repo
# with a local checkout gets its gitignored .github/secrets*.env synced too; one
# without is synced from its default branch through the API (variables,
# settings, rulesets, shared secrets — never its own secrets, which only exist
# locally). Default: the directory holding this checkout. Override with the
# CI_REPOS_ROOT environment variable.

# Where this repo lives — the slug every caller's `uses:` names, and what
# `ebalzan-ci onboard` writes into the templates. Change it only if you fork.
CI_REPO=ebalzan/ci
