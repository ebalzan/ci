# GitHub Actions VARIABLES specific to tracebim-ci itself. Non-sensitive;
# committed. Pushed by `npm run gh:bootstrap` (this repo is not in
# config/repos.env, so `--all` does not reach it); config/actions.env fills the
# rest at run time.

# This repo's Projects (v2) board (owned by AUTO_PROJECT_OWNER, shared). A copy
# of tracebim-api's board #12, so it has the same Priority/Size/Estimate/date
# fields.
AUTO_PROJECT_NUMBER=15
