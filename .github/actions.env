# GitHub Actions VARIABLES specific to tracebim-ci itself. Non-sensitive;
# committed. Merged over config/actions.env and pushed by `npm run gh:bootstrap`
# (this repo is not in config/repos.env, so `--all` does not reach it — re-run
# it here after changing a shared value).

# No Projects (v2) board for this repo: let auto-work-items create the issue
# and PR and only warn about the board. To get one, copy an existing board
# (gh project copy 12 --source-owner ebalzan --target-owner ebalzan
#  --title tracebim-ci-project), set AUTO_PROJECT_NUMBER here and drop this.
AUTO_STRICT_METADATA=false
