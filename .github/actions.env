# GitHub Actions VARIABLES specific to this repo (ebalzan/ci) itself.
# Non-sensitive; committed. Pushed by `npm run gh:bootstrap`; config/actions.env
# fills the rest at run time.

# This repo's Projects (v2) board, owned by the repo owner. Remove the line to
# run the work-items automation without a board.
AUTO_PROJECT_NUMBER=15

# Set to true once npm trusted publishing is configured for @ebalzan/ci
# (README → Publishing to npm). self-release.yml then publishes every release.
NPM_PUBLISH=true
