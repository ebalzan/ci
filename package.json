{
  "name": "@ebalzan/ci",
  "version": "3.0.2",
  "description": "One set of CI/CD rules for all your GitHub repos: reusable workflows (auto work and release PRs with AI descriptions, PR checks, semver releases), a CLI that syncs Actions config, repo settings and branch rulesets, and a commitlint commit-msg hook.",
  "keywords": [
    "github-actions",
    "reusable-workflows",
    "ci",
    "cd",
    "conventional-commits",
    "commitlint",
    "danger",
    "git-cliff",
    "semver",
    "rulesets",
    "husky",
    "commit-msg",
    "renovate-preset",
    "devops"
  ],
  "homepage": "https://github.com/ebalzan/ci#readme",
  "bugs": {
    "url": "https://github.com/ebalzan/ci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebalzan/ci.git"
  },
  "license": "MIT",
  "author": "ebalzan",
  "type": "module",
  "bin": {
    "ebalzan-ci": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "templates/",
    "renovate/",
    "docs/",
    "commitlint.config.mjs",
    "config/actions.env",
    "config/types.json",
    "config/repos.env",
    "config/repo-settings.json",
    "config/rulesets/",
    "config/secrets.env.example"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "for f in bin/*.sh actions/*/*.sh; do bash -n \"$f\" || exit 1; done && for f in bin/*.mjs scripts/*.mjs actions/*/*.mjs actions/*/*/*.mjs commitlint.config.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test 'test/*.test.mjs'",
    "gh:bootstrap": "bash bin/gh-bootstrap.sh",
    "gh:reset": "bash bin/gh-reset.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@commitlint/cli": "21.2.3"
  },
  "devDependencies": {
    "@ebalzan/config": "0.1.0",
    "danger": "14.0.7",
    "git-cliff": "2.14.2",
    "prettier": "3.9.10"
  },
  "prettier": "@ebalzan/config/prettier"
}
