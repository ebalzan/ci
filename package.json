{
  "name": "@ebalzan/ci",
  "version": "3.0.1",
  "description": "One set of CI/CD rules for all your GitHub repos: reusable workflows (Conventional Commits, auto issue/PR, semver releases), a CLI that syncs Actions config, repo settings and branch rulesets, and a commit-msg hook.",
  "keywords": [
    "github-actions",
    "reusable-workflows",
    "ci",
    "cd",
    "conventional-commits",
    "semantic-release",
    "semver",
    "rulesets",
    "husky",
    "commit-msg",
    "renovate-preset",
    "devops"
  ],
  "homepage": "https://github.com/ebalzan/ci#readme",
  "bugs": {
    "url": "https://github.com/ebalzan/ci/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebalzan/ci.git"
  },
  "license": "MIT",
  "author": "ebalzan",
  "type": "module",
  "bin": {
    "ebalzan-ci": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "managed/",
    "templates/",
    "renovate/",
    "docs/",
    "config/actions.env",
    "config/repos.env",
    "config/repo-settings.json",
    "config/rulesets/",
    "config/secrets.env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p actions/auto-work-items/tsconfig.json",
    "check": "npm run build && git diff --exit-code -- actions/auto-work-items/dist && bash -n bin/*.sh managed/scripts/release/*.sh && node --check bin/cli.mjs && node --check bin/_json.mjs && node --check scripts/release/*.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "gh:bootstrap": "bash bin/gh-bootstrap.sh",
    "gh:reset": "bash bin/gh-reset.sh",
    "sync-managed": "bash bin/sync-managed.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ebalzan/config": "0.1.0",
    "@types/node": "25.6.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "prettier": "@ebalzan/config/prettier"
}
