# Conventional Commits check for every local commit, from __CI_PACKAGE__
# (generated by `ebalzan-ci onboard`). The same rule runs on every PR title in
# CI, so a missing package only loses the early local warning — never the check.

if [ -x node_modules/.bin/ebalzan-ci ]; then
  exec node_modules/.bin/ebalzan-ci commit-msg "$1"
fi

echo "commit-msg: __CI_PACKAGE__ is not installed; commit message not checked locally."
echo "Install it with: npm install --save-dev __CI_PACKAGE__"
exit 0
